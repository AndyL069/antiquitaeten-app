# ==============================================================================
# Antiquitäten-App - Environment Configuration Template
# ==============================================================================

# Application Security
# Generate a secure key e.g. with: openssl rand -hex 32
SECRET_KEY="antik-secret-key-change-in-production-2026"

# Database Configuration
# Local SQLite default (used automatically if left empty or pointed to sqlite):
# DATABASE_URL="sqlite:///./backend/antik.db"
# Production PostgreSQL (Docker):
DATABASE_URL="postgresql://antik:antik@localhost:5432/antik_app"
POSTGRES_USER="antik"
POSTGRES_PASSWORD="change_me_to_a_secure_password"
POSTGRES_DB="antik_app"

# Google Gemini Vision AI (https://aistudio.google.com/apikey)
GOOGLE_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Authentik OIDC SSO (Optional - leave empty to disable)
AUTHENTIK_ISSUER=""
AUTHENTIK_CLIENT_ID=""
AUTHENTIK_CLIENT_SECRET=""

# CORS Allowed Origins (Comma-separated for local development or custom domains)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3003"
