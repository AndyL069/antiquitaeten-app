DATABASE_URL="postgresql://antik:antik@localhost:5432/antik_app?schema=public"
POSTGRES_USER="antik"
POSTGRES_PASSWORD=""
POSTGRES_DB="antik_app"
# Externe URL, unter der die App erreichbar ist (Docker-Host-Port 3003).
# Für Zugriff aus dem Netzwerk z. B. auf die Server-IP setzen: http://192.168.x.x:3003
AUTH_URL="http://localhost:3003"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
UPLOAD_DIR="uploads"
# Für die KI-Bilderkennung (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Optional: Anmeldung über Authentik (OIDC). Leer lassen, um sie zu deaktivieren.
AUTHENTIK_ISSUER=""
AUTHENTIK_CLIENT_ID=""
AUTHENTIK_CLIENT_SECRET=""
